[Unit]
Description=NORMORDIS normordis-kernel local and Google Drive backup
Documentation=file:/srv/normordis/repos/normordis-kernel/scripts/README.md

[Service]
Type=oneshot
WorkingDirectory=/srv/normordis/repos/normordis-kernel
Environment=RCLONE_CONFIG=/home/carlos/.config/rclone/rclone.conf
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
ExecStartPre=/usr/bin/mountpoint -q /mnt/normordis-backup
ExecStartPre=/usr/bin/test -d /mnt/normordis-backup/backups/repos
ExecStart=/usr/bin/bash /srv/normordis/repos/normordis-kernel/scripts/bash/backup/full-repo-backup.sh --keep-last 5
ExecStart=/usr/bin/bash /srv/normordis/repos/normordis-kernel/scripts/bash/backup/sync-google-drive.sh --keep-last 5
StandardOutput=append:/srv/normordis/logs/backups/normordis-kernel-backup.log
StandardError=append:/srv/normordis/logs/backups/normordis-kernel-backup.log
